<Window
    x:Class="Intento.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock Text="Intento" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="What do you intend to do today?" FontSize="24" />
            <TextBlock Text="Create a workspace for your apps, websites, and folders." Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="20" VerticalAlignment="Center">
            <ItemsRepeater x:Name="ActivitiesRepeater">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="220" MinItemHeight="120" MinColumnSpacing="16" MinRowSpacing="16" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Button Click="ActivityButton_Click" Tag="{Binding}" MinWidth="220" MinHeight="120">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Icon}" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="18" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Button x:Name="AddActivityButton"
                    Click="AddActivity_Click"
                    Width="220"
                    Height="120"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="64"
                    FontWeight="Light"
                    Content="+"
                    AutomationProperties.Name="Add activity" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <Button Content="Reload" Click="Reload_Click" />
            <Button Content="Exit" Click="Exit_Click" />
        </StackPanel>
    </Grid>
</Window>
